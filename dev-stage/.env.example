# KMO DEV-Stage env [CRUX-MK]
# Copy to .env and fill in. NIE in Git committen (siehe .gitignore).

# Approval-Gate HMAC secret. >=32 bytes empfohlen. Nur DEV-Wert hier.
KMO_APPROVAL_SECRET=change-me-in-prod-32-bytes-min

# Cloudflare Tunnel Token (aus setup-cloudflared.sh).
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Logging (DEBUG nur fuer DEV).
KMO_LOG_LEVEL=DEBUG

# Demo-Dashboard Basic-Auth (Mac-Local Public-URL Schutz).
KMO_DEMO_AUTH_USER=martin
KMO_DEMO_AUTH_PASS=change-me

# Audit-Volume Host-Path (read-only mount fuer Demo-Page).
# Default zeigt auf branch-hub/audit auf dem Mac. Ueberschreiben falls anders.
KMO_AUDIT_HOST_PATH=/Users/make/Library/CloudStorage/GoogleDrive-m.e.o.kemmer@gmail.com/Meine Ablage/Claude-Knowledge-System/branch-hub/audit
